{
  "name": "fleet-cdisc",
  "displayName": "Fleet CDISC",
  "description": "Language support for Fleet define.yaml specifications: schema diagnostics, algorithm/codelist completions, and hover docs.",
  "version": "0.1.0",
  "publisher": "fleet-cdisc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RealSlimMahdi/fleet-cdisc"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:**/define.yaml",
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  }
}
